# Copy this file to .env and fill in the values
ANTHROPIC_API_KEY=sk-ant-...

# Internal integration token for the Notion workspace containing the 3 task destinations
NOTION_TOKEN=ntn_...

# Google Calendar (individual fields — avoids JSON-in-TOML issues on Streamlit Cloud)
GOOGLE_REFRESH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook Calendar
MS_CLIENT_ID=
MS_TENANT_ID=consumers
MS_REFRESH_TOKEN=
